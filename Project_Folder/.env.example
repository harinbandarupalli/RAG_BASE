# ==============================================================================
# ENTERPRISE RAG STARTER KIT — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your target values.
# ==============================================================================

# --- Application Environment ---
APP_NAME=Enterprise-RAG-StarterKit
APP_ENV=development                       # development | staging | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=dev                           # dev (colorized) | json (structured JSON)
DEBUG=true

# --- API Server Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
API_KEY_SECRET=changeme_in_production_secret_key

# --- Primary LLM Provider & Default Models ---
DEFAULT_LLM_PROVIDER=openai               # openai | anthropic | gemini | groq | ollama
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048

# --- LLM Provider API Keys ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=AIzaSy-your-gemini-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding Model Provider ---
EMBEDDING_PROVIDER=openai                 # openai | huggingface | cohere
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Relational Database & Vector Store (PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_secure_password
POSTGRES_SCHEMA=public
VECTOR_COLLECTION_NAME=enterprise_knowledge_base

# --- Redis Semantic Cache & Session Store ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.96            # Cosine similarity threshold for instant cache hit
SEMANTIC_CACHE_TTL_SECONDS=86400         # 24 hours

# --- Observability Desk & Tracing (Strict Hub Policy) ---
# Supported backends: langsmith | langfuse | phoenix | none
OBSERVABILITY_BACKEND=langfuse

# 1. Langfuse Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# 2. LangSmith Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key
LANGCHAIN_PROJECT=enterprise-rag-starter
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 3. Arize Phoenix (Open-Source Tracing)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Strict Remote Prompt Hub (NO LOCAL FALLBACK) ---
# Name of the prompt in the remote registry (Langfuse / LangChain Hub)
REMOTE_PROMPT_NAME=rag-qa-enterprise
REMOTE_PROMPT_VERSION=production
PROMPT_CACHE_TTL_SECONDS=300             # 5 minutes in-memory TTL before re-checking remote hub

# --- Reranking Configuration ---
RERANKER_PROVIDER=flashrank              # flashrank (local fast CPU) | cohere
COHERE_API_KEY=your-cohere-api-key
RERANKER_TOP_N=5

# --- Task Supervisor & Budget Guards ---
TASK_TIMEOUT_SECONDS=60
MAX_TOKEN_BUDGET_PER_RUN=4000            # Kills generation if run exceeds this limit
ENABLE_HALLUCINATION_CHECK=true          # Self-RAG reflection guardrail
